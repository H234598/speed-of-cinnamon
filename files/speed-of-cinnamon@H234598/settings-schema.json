{
  "layout": {
    "type": "layout",
    "pages": ["main-page"],
    "main-page": {
      "type": "page",
      "title": "Speed of Cinnamon",
      "sections": ["activation-section", "recording-section", "personalization-section", "notification-section", "output-section", "backend-section"]
    },
    "activation-section": {
      "type": "section",
      "title": "Activation",
      "keys": ["toggle-keybinding", "show-panel-label"]
    },
    "recording-section": {
      "type": "section",
      "title": "Recording",
      "keys": ["language", "secondary-language", "max-seconds", "recorder", "input-device"]
    },
    "personalization-section": {
      "type": "section",
      "title": "Personalization",
      "keys": ["personal-context", "vocabulary"]
    },
    "notification-section": {
      "type": "section",
      "title": "Notifications",
      "keys": ["notify-recording", "notify-complete", "notify-error"]
    },
    "output-section": {
      "type": "section",
      "title": "Text output",
      "keys": ["insert-method", "append-space", "typing-delay-ms"]
    },
    "backend-section": {
      "type": "section",
      "title": "Backend",
      "keys": ["cli-path", "transcriber", "whisper-model", "transcriber-command", "post-process-command"]
    }
  },
  "toggle-keybinding": {
    "type": "keybinding",
    "description": "Start or stop dictation",
    "default": "<Super>z::"
  },
  "show-panel-label": {
    "type": "switch",
    "description": "Show status text in the panel",
    "default": true
  },
  "language": {
    "type": "combobox",
    "description": "Primary recognition language",
    "options": {
      "English": "en",
      "German": "de",
      "Spanish": "es",
      "French": "fr",
      "Italian": "it",
      "Dutch": "nl"
    },
    "default": "en"
  },
  "secondary-language": {
    "type": "combobox",
    "description": "Secondary recognition language",
    "options": {
      "English": "en",
      "German": "de",
      "Spanish": "es",
      "French": "fr",
      "Italian": "it",
      "Dutch": "nl"
    },
    "default": "de"
  },
  "max-seconds": {
    "type": "spinbutton",
    "description": "Maximum recording length",
    "min": 5,
    "max": 300,
    "step": 5,
    "units": "s",
    "default": 30
  },
  "recorder": {
    "type": "combobox",
    "description": "Recorder",
    "options": {
      "Automatic": "auto",
      "PipeWire pw-record": "pw-record",
      "PulseAudio parecord": "parecord",
      "ALSA arecord": "arecord"
    },
    "default": "auto"
  },
  "input-device": {
    "type": "entry",
    "description": "Input device",
    "tooltip": "Optional PipeWire/Pulse source name. Leave empty for the current default. Run 'speed-of-cinnamon list-inputs --json' to inspect available sources.",
    "default": ""
  },
  "personal-context": {
    "type": "textview",
    "description": "Personal context",
    "tooltip": "Optional local-only context for custom ASR or post-processing commands. Available as {context}, {prompt}, and SPEED_OF_CINNAMON_CONTEXT.",
    "height": 120,
    "default": ""
  },
  "vocabulary": {
    "type": "textview",
    "description": "Custom vocabulary",
    "tooltip": "Optional terms, one per line. Available as {vocabulary}, {prompt}, and SPEED_OF_CINNAMON_VOCABULARY.",
    "height": 120,
    "default": ""
  },
  "notify-recording": {
    "type": "switch",
    "description": "Notify when recording starts or reaches the time limit",
    "default": false
  },
  "notify-complete": {
    "type": "switch",
    "description": "Notify when dictation is ready",
    "default": true
  },
  "notify-error": {
    "type": "switch",
    "description": "Notify on dictation errors",
    "default": true
  },
  "insert-method": {
    "type": "combobox",
    "description": "Insert method",
    "options": {
      "Clipboard and paste": "clipboard-paste",
      "Clipboard only": "clipboard",
      "Direct typing": "type",
      "Do not insert": "none"
    },
    "default": "clipboard-paste"
  },
  "append-space": {
    "type": "switch",
    "description": "Append a space after inserted text",
    "default": true
  },
  "typing-delay-ms": {
    "type": "spinbutton",
    "description": "Direct typing delay",
    "min": 0,
    "max": 100,
    "step": 1,
    "units": "ms",
    "default": 8
  },
  "cli-path": {
    "type": "entry",
    "description": "Backend command",
    "default": "/home/teladi/.local/bin/speed-of-cinnamon"
  },
  "transcriber": {
    "type": "combobox",
    "description": "Transcriber",
    "tooltip": "Automatic uses a custom command when one is configured, then the whisper command when installed, then whisper.cpp when a model path is configured.",
    "options": {
      "Automatic": "auto",
      "OpenAI Whisper command": "whisper",
      "whisper.cpp": "whisper-cpp",
      "Custom command": "command"
    },
    "default": "auto"
  },
  "whisper-model": {
    "type": "filechooser",
    "description": "whisper.cpp model",
    "tooltip": "Model file used when the transcriber is whisper.cpp, for example ggml-base.bin.",
    "default": ""
  },
  "transcriber-command": {
    "type": "entry",
    "description": "Transcriber command template",
    "tooltip": "Used by the Custom command transcriber, or by Automatic when filled. Template placeholders: {audio}, {language}, {text}, {output_dir}, {output_base}, {context}, {vocabulary}, {prompt}. The command must print the transcript or write it to {text}.",
    "default": ""
  },
  "post-process-command": {
    "type": "entry",
    "description": "Post-process command",
    "tooltip": "Optional text polishing command. It receives the transcript on stdin and must print the final text. Template placeholders: {text}, {language}, {context}, {vocabulary}, {prompt}.",
    "default": ""
  }
}
